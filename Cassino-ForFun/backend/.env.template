# Servidor
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Seguranca
JWT_SECRET=troque-esta-chave-secreta

# Admins iniciais (criados automaticamente no registro)
ADMIN_EMAILS=admin@dbet.app

# Banco (MongoDB; replica set recomendado para transacoes)
MONGO_URI=mongodb://localhost:27017/dbet

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=

# Apostas esportivas - The Odds API (https://the-odds-api.com)
# Sem chave, o sistema usa o provedor DEMO (partidas sinteticas).
ODDS_API_KEY=
ODDS_API_SPORTS=soccer_epl,soccer_brazil_campeonato,basketball_nba,tennis_atp
ODDS_SYNC_CRON=0 */6 * * *

# Discord bot (opcional)
DISCORD_BOT_SECRET=

# Limite de requisicoes anti-abuso para registro (por IP/hora)
REGISTER_LIMIT=20
